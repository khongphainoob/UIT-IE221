 as="geometry"><Array as="points"><mxPoint x="1762.5" y="635" /><mxPoint x="1945" y="635" /></Array></mxGeometry></mxCell><mxCell id="p3_gen_e2" value="" style="edgeStyle=none;rounded=1;arcSize=6;html=1;endArrow=block;endFill=0;endSize=11;strokeColor=#0369a1;strokeWidth=1.8;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_exp_xlsx" target="p3_exp_base"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2127.5" y="635" /><mxPoint x="1945" y="635" /></Array></mxGeometry></mxCell><mxCell id="p3_legend" value="&lt;b&gt;TÓM TẮT 4 TÍNH CHẤT OOP &amp;amp; 3 DESIGN PATTERNS:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Trừu tượng (Abstraction)&lt;/b&gt;: &lt;i&gt;BaseFinancialAnalyzer&lt;/i&gt;, &lt;i&gt;SavingStrategy&lt;/i&gt;, &lt;i&gt;BaseReportExporter&lt;/i&gt;.&lt;br/&gt;2. &lt;b&gt;Kế thừa (Inheritance)&lt;/b&gt;: 3 Engine con kế thừa &lt;i&gt;BaseFinancialAnalyzer&lt;/i&gt; (mũi tên ──▷).&lt;br/&gt;3. &lt;b&gt;Đóng gói (Encapsulation)&lt;/b&gt;: Thuộc tính &lt;code&gt;_raw_data&lt;/code&gt;, &lt;code&gt;_dataframe&lt;/code&gt;, &lt;code&gt;_daily_burn_rate&lt;/code&gt;.&lt;br/&gt;4. &lt;b&gt;Đa hình &amp;amp; Patterns&lt;/b&gt;: Template Method (&lt;code&gt;run_inference&lt;/code&gt;), Singleton (&lt;code&gt;MLModelRegistry&lt;/code&gt; chỉ load &lt;code&gt;.joblib&lt;/code&gt;), Strategy (&lt;code&gt;SavingStrategy&lt;/code&gt; &amp;amp; &lt;code&gt;BaseReportExporter&lt;/code&gt;)." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;strokeWidth=1.2;strokeColor=#64748b;fillColor=#f8fafc;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="1570" y="990" width="750" height="210" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="04RequestFlowMVT" name="04 - Vòng Đời Request MVT &amp; Tách Biệt Service/Repo/Engine"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="1160" background="#ffffff" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4_banner" value="TRANG 4: VÒNG ĐỜI REQUEST-RESPONSE CHUẨN DJANGO MVT (M - V - T) &amp;amp; TẦNG MỞ RỘNG (SERVICE / REPOSITORY / ENGINE)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;strokeWidth=1.5;strokeColor=#0f172a;fillColor=#0f172a;fontColor=#ffffff;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="40" y="24" width="2200" height="54" as="geometry" /></mxCell><mxCell id="p4_cli" value="1. Client / Trình duyệt" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=34;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#e2e8f0;swimlaneFillColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="50" y="175" width="200" height="126" as="geometry" /></mxCell><mxCell id="p4_cli_body" value="Gửi HTTP Request&lt;br/&gt;(&lt;i&gt;Web / Swagger JSON&lt;/i&gt;)" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_cli"><mxGeometry x="0" y="34" width="200" height="92" as="geometry" /></mxCell><mxCell id="p4_url" value="2. URL Dispatcher" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=34;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#e2e8f0;swimlaneFillColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="315" y="175" width="205" height="126" as="geometry" /></mxCell><mxCell id="p4_url_body" value="&lt;code&gt;config/urls.py&lt;/code&gt;&lt;br/&gt;&lt;code&gt;apps/finance/urls.py&lt;/code&gt;" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_url"><mxGeometry x="0" y="34" width="205" height="92" as="geometry" /></mxCell><mxCell id="p4_view" value="[V] View — Trung Tâm Điều Phối" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=34;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#dbeafe;swimlaneFillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="585" y="155" width="315" height="166" as="geometry" /></mxCell><mxCell id="p4_view_body" value="&lt;code&gt;TransactionListCreateAPIView&lt;/code&gt; / &lt;code&gt;web_views&lt;/code&gt;&lt;br/&gt;• Nhận Request &amp;amp; kiểm tra RBAC&lt;br/&gt;• Lọc input (&lt;code&gt;Serializer.is_valid()&lt;/code&gt;), gọi &lt;code&gt;Service&lt;/code&gt;&lt;br/&gt;• Nhận Python Object từ &lt;code&gt;Model [M]&lt;/code&gt; đẩy sang &lt;code&gt;[T]&lt;/code&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_view"><mxGeometry x="0" y="34" width="315" height="132" as="geometry" /></mxCell><mxCell id="p4_svc" value="[Tầng Mở Rộng] Service Layer" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=34;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffedd5;swimlaneFillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;fontColor=#9a3412;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="975" y="165" width="340" height="146" as="geometry" /></mxCell><mxCell id="p4_svc_body" value="&lt;code&gt;TransactionService.record_transaction()&lt;/code&gt;&lt;br/&gt;• Tách khỏi View để tránh &lt;i&gt;Fat Views&lt;/i&gt;&lt;br/&gt;• Điều phối nghiệp vụ &lt;code&gt;@transaction.atomic&lt;/code&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_svc"><mxGeometry x="0" y="34" width="340" height="112" as="geometry" /></mxCell><mxCell id="p4_repo" value="[Tầng Mở Rộng] Repository Layer" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=34;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ede9fe;swimlaneFillColor=#ffffff;strokeColor=#6d28d9;strokeWidth=1.5;fontColor=#5b21b6;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="1390" y="110" width="345" height="116" as="geometry" /></mxCell><mxCell id="p4_repo_body" value="&lt;code&gt;WalletRepository&lt;/code&gt;, &lt;code&gt;TransactionRepository&lt;/code&gt;&lt;br/&gt;• Đóng gói truy vấn ORM (&lt;code&gt;select_for_update&lt;/code&gt;)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_repo"><mxGeometry x="0" y="34" width="345" height="82" as="geometry" /></mxCell><mxCell id="p4_eng" value="[Tầng Mở Rộng] Analytics &amp;amp; AI Engine" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=34;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#fce7f3;swimlaneFillColor=#ffffff;strokeColor=#be185d;strokeWidth=1.5;fontColor=#9d174d;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="1390" y="250" width="345" height="116" as="geometry" /></mxCell><mxCell id="p4_eng_body" value="&lt;code&gt;BurnRateAnalyzer&lt;/code&gt;, &lt;code&gt;AnomalyDetectionEngine&lt;/code&gt;, &lt;code&gt;RiskClassifier&lt;/code&gt;&lt;br/&gt;• Nạp &lt;code&gt;.joblib&lt;/code&gt; (Load-only) &amp;amp; tính Pandas" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_eng"><mxGeometry x="0" y="34" width="345" height="82" as="geometry" /></mxCell><mxCell id="p4_model" value="[M] Model — Thuần Schema &amp;amp; ORM" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=34;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#fee2e2;swimlaneFillColor=#ffffff;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#991b1b;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="1830" y="110" width="400" height="136" as="geometry" /></mxCell><mxCell id="p4_model_body" value="&lt;code&gt;apps/finance/models/&lt;/code&gt; (7 bảng 3NF)&lt;br/&gt;• Khai báo Bảng, Cột, Khóa ngoại, Ràng buộc&lt;br/&gt;• Trả Python Objects (ORM) ngược về cho View" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_model"><mxGeometry x="0" y="34" width="400" height="102" as="geometry" /></mxCell><mxCell id="p4_tpl" value="[T] Template / Serializer Presentation (Tầng Hiển Thị Đầu Ra)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=34;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#dcfce7;swimlaneFillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.5;fontColor=#166534;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="585" y="455" width="540" height="126" as="geometry" /></mxCell><mxCell id="p4_tpl_body" value="• &lt;b&gt;Web MVT&lt;/b&gt;: &lt;code&gt;templates/finance/dashboard.html&lt;/code&gt; (HTML + DTL + Chart.js)&lt;br/&gt;• &lt;b&gt;REST API (DRF)&lt;/b&gt;: &lt;code&gt;Serializer.data&lt;/code&gt; + &lt;code&gt;JSONRenderer&lt;/code&gt; → Chuỗi JSON" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_tpl"><mxGeometry x="0" y="34" width="540" height="92" as="geometry" /></mxCell><mxCell id="p4_e1" value="1. HTTP" style="edgeStyle=none;rounded=1;arcSize=6;html=1;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;endSize=9;strokeColor=#475569;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_cli" target="p4_url"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_e2" value="2. Route" style="edgeStyle=none;rounded=1;arcSize=6;html=1;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;endSize=9;strokeColor=#475569;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_url" target="p4_view"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_e3" value="3. Gọi" style="edgeStyle=none;rounded=1;arcSize=6;html=1;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;endSize=9;strokeColor=#475569;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_view" target="p4_svc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_e_repo" value="ORM" style="edgeStyle=none;rounded=1;arcSize=6;html=1;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;endSize=9;strokeColor=#475569;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_svc" target="p4_repo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1352" y="201.5" /><mxPoint x="1352" y="168" /></Array></mxGeometry></mxCell><mxCell id="p4_e_eng" value="ML/Pandas" style="edgeStyle=none;rounded=1;arcSize=6;html=1;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;endSize=9;strokeColor=#475569;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;exitX=1.0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_svc" target="p4_eng"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1352" y="274.5" /><mxPoint x="1352" y="308" /></Array></mxGeometry></mxCell><mxCell id="p4_e_mod" value="3. Truy vấn" style="edgeStyle=none;rounded=1;arcSize=6;html=1;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;endSize=9;strokeColor=#475569;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.42647;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_repo" target="p4_model"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_ret_m" value="4. Trả Python Object (ORM) về View [V]" style="edgeStyle=none;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#15803d;strokeWidth=1.8;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;fontColor=#166534;fontFamily=Helvetica;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.714286;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_model" target="p4_view"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2030" y="405" /><mxPoint x="810" y="405" /></Array></mxGeometry></mxCell><mxCell id="p4_v_tpl" value="5. Truyền dữ liệu" style="edgeStyle=none;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#15803d;strokeWidth=1.8;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;fontColor=#166534;fontFamily=Helvetica;exitX=0.35;exitY=1.0;exitDx=0;exitDy=0;entryX=0.204167;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_view" target="p4_tpl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_tpl_cli" value="6. HTTP Response (HTML / JSON)" style="edgeStyle=none;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#15803d;strokeWidth=1.8;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;fontColor=#166534;fontFamily=Helvetica;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_tpl" target="p4_cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="518" /></Array></mxGeometry></mxCell><mxCell id="p4_box_m" value="M — MODEL (models/*.py)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=38;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#fee2e2;swimlaneFillColor=#ffffff;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#991b1b;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="50" y="630" width="525" height="370" as="geometry" /></mxCell><mxCell id="p4_box_m_body" value="• &lt;b&gt;Vai trò thuần MVT:&lt;/b&gt; Chỉ quản lý cấu trúc CSDL &amp;amp; giao diện ORM (&lt;b&gt;KHÔNG&lt;/b&gt; chứa Service hay ML Engine).&lt;br/&gt;&lt;br/&gt;• Định nghĩa 7 bảng chuẩn 3NF kế thừa &lt;code&gt;BaseModel&lt;/code&gt; (&lt;code&gt;UserAccount&lt;/code&gt;, &lt;code&gt;Wallet&lt;/code&gt;, &lt;code&gt;ExpenseCategory&lt;/code&gt;, &lt;code&gt;ExpenseTransaction&lt;/code&gt;, &lt;code&gt;MonthlyBudget&lt;/code&gt;, &lt;code&gt;RecurringBill&lt;/code&gt;, &lt;code&gt;BudgetAlertLog&lt;/code&gt;).&lt;br/&gt;&lt;br/&gt;• Khai báo cột, kiểu dữ liệu, khóa ngoại FK và ràng buộc toàn vẹn (&lt;code&gt;CheckConstraint&lt;/code&gt;, &lt;code&gt;UniqueConstraint&lt;/code&gt;)." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_box_m"><mxGeometry x="0" y="38" width="525" height="332" as="geometry" /></mxCell><mxCell id="p4_box_v" value="V — VIEW (views/ &amp;amp; urls.py)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=38;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#dbeafe;swimlaneFillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="601" y="630" width="525" height="370" as="geometry" /></mxCell><mxCell id="p4_box_v_body" value="• &lt;b&gt;Vai trò thuần MVT:&lt;/b&gt; Trung tâm điều phối luồng xử lý (tương đương &lt;i&gt;Controller&lt;/i&gt; trong MVC).&lt;br/&gt;&lt;br/&gt;• Tiếp nhận HTTP Request từ &lt;code&gt;urls.py&lt;/code&gt;, kiểm tra phân quyền RBAC (&lt;code&gt;IsStudentOwner&lt;/code&gt;, &lt;code&gt;IsAdmin&lt;/code&gt;).&lt;br/&gt;&lt;br/&gt;• Lọc dữ liệu API đầu vào bằng &lt;code&gt;Serializer.is_valid()&lt;/code&gt;, ủy quyền sang tầng &lt;b&gt;Service&lt;/b&gt;, nhận Python Object từ &lt;b&gt;[M]&lt;/b&gt; rồi đẩy sang &lt;b&gt;[T]&lt;/b&gt; trả HTTP Response." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_box_v"><mxGeometry x="0" y="38" width="525" height="332" as="geometry" /></mxCell><mxCell id="p4_box_t" value="T — TEMPLATE (templates/ &amp;amp; Serializer.data)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=38;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#dcfce7;swimlaneFillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.5;fontColor=#166534;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="1152" y="630" width="525" height="370" as="geometry" /></mxCell><mxCell id="p4_box_t_body" value="• &lt;b&gt;Vai trò thuần MVT:&lt;/b&gt; Tầng trình bày dữ liệu đầu ra cho người dùng (chỉ nằm ở &lt;b&gt;Chiều RA&lt;/b&gt;).&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Web MVT:&lt;/b&gt; &lt;code&gt;templates/finance/dashboard.html&lt;/code&gt; dùng Django Template Language (&lt;code&gt;{{ var }}&lt;/code&gt;, &lt;code&gt;{% for %}&lt;/code&gt;) + Chart.js kết xuất trang HTML.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;REST API (DRF):&lt;/b&gt; Thay thế Template bằng &lt;code&gt;Serializer.data&lt;/code&gt; + &lt;code&gt;JSONRenderer&lt;/code&gt; để xuất chuỗi JSON cho Client." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_box_t"><mxGeometry x="0" y="38" width="525" height="332" as="geometry" /></mxCell><mxCell id="p4_box_ext" value="TẦNG MỞ RỘNG (KHÔNG GỘP VÀO [M] HAY [V])" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;horizontal=1;startSize=38;collapsible=0;swimlaneLine=1;whiteSpace=wrap;html=1;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffedd5;swimlaneFillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;fontColor=#9a3412;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="1703" y="630" width="525" height="370" as="geometry" /></mxCell><mxCell id="p4_box_ext_body" value="• &lt;b&gt;Mục đích tách lớp:&lt;/b&gt; Nằm trung gian giữa &lt;b&gt;View [V]&lt;/b&gt; và &lt;b&gt;Model [M]&lt;/b&gt; để chống phình View (&lt;i&gt;Fat Views&lt;/i&gt;) và giữ &lt;code&gt;Model&lt;/code&gt; thuần túy.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;services/&lt;/b&gt;: Điều phối nghiệp vụ cốt lõi &amp;amp; giao dịch nguyên tử &lt;code&gt;@transaction.atomic&lt;/code&gt;.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;repositories/&lt;/b&gt;: Đóng gói câu lệnh truy vấn ORM an toàn (&lt;code&gt;select_related&lt;/code&gt;, &lt;code&gt;select_for_update&lt;/code&gt;).&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;engines/&lt;/b&gt;: Phân tích Pandas &amp;amp; suy luận ML/DL nạp sẵn (&lt;code&gt;MLModelRegistry&lt;/code&gt;)." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="p4_box_ext"><mxGeometry x="0" y="38" width="525" height="332" as="geometry" /></mxCell><mxCell id="p4_legend" value="&lt;b&gt;Tổng kết chuẩn Django MVT + Clean Architecture:&lt;/b&gt; &amp;nbsp; &lt;b&gt;[M] Model&lt;/b&gt; chỉ chứa Schema 3NF &amp;amp; ORM; &amp;nbsp; &lt;b&gt;[V] View&lt;/b&gt; điều phối vòng đời Request–Response; &amp;nbsp; &lt;b&gt;[T] Template / Serializer (.data)&lt;/b&gt; kết xuất HTML/JSON ở chiều ra; &amp;nbsp; còn &lt;b&gt;Service / Repository / Engine&lt;/b&gt; là các tầng mở rộng trung gian giúp code sạch, dễ bảo trì và dễ viết Unit Test." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;strokeWidth=1.2;strokeColor=#64748b;fillColor=#f8fafc;fontColor=#0f172a;fontSize=12;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1" data-role="box"><mxGeometry x="50" y="1030" width="2178" height="82" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>